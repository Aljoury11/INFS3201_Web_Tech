<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Employee Details</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>{{employee.name}}</h1>
  <p><strong>ID:</strong> {{employee._id}}</p>
  <p><strong>Phone:</strong> {{employee.phone}}</p>

  <p>
    <img src="/employees/{{employee._id}}/photo" alt="Employee photo" width="200">
  </p>

  <p><a href="/employees/{{employee._id}}/edit">Edit Details</a></p>

  <h2>Shifts</h2>

  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Start</th>
        <th>End</th>
      </tr>
    </thead>
    <tbody>
      {{#each shifts}}
        <tr>
          <td>{{date}}</td>
          <td class="{{#if isMorning}}morning{{/if}}">{{startTime}}</td>
          <td>{{endTime}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <p><a href="/">Back</a></p>
  <div style="text-align:right;">
    <a href="/logout">Logout</a>
</div>
</body>
</html>